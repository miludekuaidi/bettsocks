}

_DASH_OPEN = False

# 同一进程里只能加载一种 Go 内核（两个 Go 运行时混用不稳定）
_LIB = None
_LIB_KIND = None
_LIB_FUNCS = None


class NeedRestart(Exception):
    pass


_OnClick = jclass("android.content.DialogInterface$OnClickListener")


class _Click(dynamic_proxy(_OnClick)):
    def __init__(self, fn):
        super().__init__()
        self._fn = fn

    def onClick(self, dialog, which):
        try:
            self._fn(int(which))
        except Exception:
            pass


# ---------- 工具 ----------
def _toast(msg):
    def go():
        try:
            jclass("android.widget.Toast").makeText(
                ApplicationLoader.applicationContext, str(msg), 1).show()
        except Exception:
            pass
    run_on_ui_thread(go)


def _info(msg):
    if _DASH_OPEN:  # 控制面板盖住了提示条，改用 Toast
        _toast(msg)
        return
    try:
        run_on_ui_thread(lambda: BulletinHelper.show_info(str(msg)))
    except Exception:
        pass


def _err(msg):
    if _DASH_OPEN:
        _toast(msg)
        return
    try:
        run_on_ui_thread(lambda: BulletinHelper.show_error(str(msg)))
    except Exception:
        pass


def _home():
    ctx = ApplicationLoader.applicationContext
    d = str(ctx.getDir("proxy_mihomo", 0).getAbsolutePath())
    os.makedirs(d, exist_ok=True)
    return d


def _core_path(kind):
    return os.path.join(_home(), CORES[kind]["file"])


def _as_bool(v):
    if isinstance(v, str):
        return v.strip().lower() in ("1", "true", "yes", "on")
    return bool(v)


def _is_sub_url(value):
    return re.match(r"^https?://\S+$", str(value).strip(), re.I) is not None


def _short(value):
    value = str(value).strip()
    if _is_sub_url(value):
        u = urllib.parse.urlparse(value)
        s = u.netloc + u.path
        return s if len(s) <= 30 else s[:29] + "…"
    return "%d 条节点链接" % len([x for x in re.split(r"\s+", value) if x])


def _default_name(value, index):
    value = str(value).strip()
    if _is_sub_url(value):
        return urllib.parse.urlparse(value).netloc or ("订阅%d" % index)
    return "手动节点"


def _q(x):
    return urllib.parse.quote(str(x), safe="")


def _port_free(p):
    s = socket.socket()
    try:
        s.bind(("127.0.0.1", p))
        return True
    except OSError:
        return False
    finally:
        s.close()


def pick_ports(preferred):
    """找一对相邻的空闲端口（代理端口 + 控制端口），避免和其它代理软件冲突。"""
    for p in range(preferred, preferred + 60, 2):
        if _port_free(p) and _port_free(p + 1):
            return p, p + 1
    raise RuntimeError("找不到可用端口，请换一个本地端口")


# ---------- mihomo 配置 ----------
def _re_quote(s):
    return re.sub(r"([\\.+*?()|\[\]{}^$])", r"\\\1", s)



def build_mihomo_config(sources, port, ctl_port, secret, home, groups=None):
    hc = {"enable": True, "url": HC_URL, "interval": 300}
    providers, meta = {}, {}
    for i, s in enumerate(sources):
        pid = "s%d" % i
        value = str(s["value"]).strip()
        if _is_sub_url(value):
            providers[pid] = {
                "type": "http", "url": value,
                "path": os.path.join(home, "%s.yaml" % pid),
                "interval": 3600, "proxy": "DIRECT",
                "header": {"User-Agent": ["clash.meta"]},
                "health-check": hc,
            }
            meta[pid] = {"name": s["name"], "kind": "sub"}
        else:
            p = os.path.join(home, "%s.txt" % pid)
            with open(p, "w", encoding="utf-8") as f:
                f.write("\n".join(x for x in re.split(r"\s+", value) if x) + "\n")
            providers[pid] = {"type": "file", "path": p, "health-check": hc}
            meta[pid] = {"name": s["name"], "kind": "links"}
    use = list(providers)
    gnames, ggroups = [], []
    for g in groups or []:
        if not g["nodes"]:
            continue
        gname = "G:" + g["name"]
        filt = "^(?:" + "|".join(_re_quote(n) for n in g["nodes"]) + ")$"
        ggroups.append({"name": gname, "type": "url-test", "use": use, "filter": filt,
                        "url": HC_URL, "interval": 300, "tolerance": 50})
        gnames.append(gname)
    cfg = {
        "mixed-port": int(port),
        "bind-address": "127.0.0.1",
        "external-controller": "127.0.0.1:%d" % int(ctl_port),
        "secret": secret,
        "allow-lan": False,
        "mode": "rule",
        "log-level": "warning",
        "ipv6": False,
        "find-process-mode": "off",
        "unified-delay": True,
        "tcp-concurrent": True,
        "dns": {"enable": True, "ipv6": False,
                "default-nameserver": ["223.5.5.5", "8.8.8.8"],
                "nameserver": ["223.5.5.5", "8.8.8.8"]},
        "proxy-providers": providers,
        "proxy-groups": [
            {"name": "PROXY", "type": "select", "proxies": ["AUTO"] + gnames, "use": use},
            {"name": "AUTO", "type": "url-test", "use": use, "url": HC_URL,
             "interval": 300, "tolerance": 50},
        ] + ggroups,
        "rules": ["MATCH,PROXY"],
    }
    return cfg, meta


# ---------- sing-box：分享链接 → outbound ----------
def _b64d(s):
    s = s.strip().replace("-", "+").replace("_", "/")
    return base64.b64decode(s + "=" * (-len(s) % 4))


def _qs(u):
    return {k: v[0] for k, v in urllib.parse.parse_qs(u.query).items()}


def _truthy(v):
    return str(v).lower() in ("1", "true")


def _tls(q, host, default_on):
    sec = q.get("security", "tls" if default_on else "none")
    if sec not in ("tls", "reality"):
        return None
    t = {"enabled": True,
         "server_name": q.get("sni") or q.get("peer") or q.get("host") or host}
    if _truthy(q.get("allowInsecure", "")) or _truthy(q.get("insecure", "")):
        t["insecure"] = True
    if q.get("alpn"):
        t["alpn"] = q["alpn"].split(",")
    if q.get("fp") or sec == "reality":
        t["utls"] = {"enabled": True, "fingerprint": q.get("fp") or "chrome"}
    if sec == "reality":
        t["reality"] = {"enabled": True, "public_key": q.get("pbk", ""),
                        "short_id": q.get("sid", "")}
    return t


def _transport(net, q):
    net = net or "tcp"
    path = urllib.parse.unquote(q.get("path") or "/")
    host = q.get("host") or ""
    if net == "ws":
        t = {"type": "ws", "path": path}
        if host:
            t["headers"] = {"Host": host}
        return t
    if net == "grpc":
        return {"type": "grpc", "service_name": q.get("serviceName") or q.get("path") or ""}
    if net == "httpupgrade":
        t = {"type": "httpupgrade", "path": path}
        if host:
            t["host"] = host
        return t
    if net in ("h2", "http"):
        t = {"type": "http", "path": path}
        if host:
            t["host"] = [host]
        return t
    if net == "tcp":
        if q.get("headerType") == "http":
            raise ValueError("不支持 tcp http 伪装")
        return None
    raise ValueError("不支持的传输: " + net)


def _ob_vmess(uri):
    d = json.loads(_b64d(uri[8:].split("#", 1)[0]).decode("utf-8"))
    q = {"host": d.get("host", ""), "path": d.get("path", "/"), "sni": d.get("sni", ""),
         "alpn": d.get("alpn", ""), "fp": d.get("fp", ""),
         "security": "tls" if d.get("tls") == "tls" else "none",
         "headerType": d.get("type", "none")}
    ob = {"type": "vmess", "tag": d.get("ps") or "vmess", "server": d["add"],
          "server_port": int(d["port"]), "uuid": d["id"],
          "security": d.get("scy") or "auto", "alter_id": int(d.get("aid") or 0)}
    tls = _tls(q, d["add"], False)
    if tls:
        ob["tls"] = tls
    tr = _transport(d.get("net"), q)
    if tr:
        ob["transport"] = tr
    return ob


def _ob_vless(uri):
    u = urllib.parse.urlparse(uri)
    q = _qs(u)
    ob = {"type": "vless", "tag": urllib.parse.unquote(u.fragment) or "vless",
          "server": u.hostname, "server_port": u.port or 443,
          "uuid": urllib.parse.unquote(u.username or "")}
    if q.get("flow"):
        ob["flow"] = q["flow"]
    ob["packet_encoding"] = "xudp"
    tls = _tls(q, u.hostname, False)
    if tls:
        ob["tls"] = tls
    tr = _transport(q.get("type"), q)
    if tr:
        ob["transport"] = tr
    return ob


def _ob_trojan(uri):
    u = urllib.parse.urlparse(uri)
    q = _qs(u)
    ob = {"type": "trojan", "tag": urllib.parse.unquote(u.fragment) or "trojan",
          "server": u.hostname, "server_port": u.port or 443,
          "password": urllib.parse.unquote(u.username or "")}
    tls = _tls(q, u.hostname, True)
    if tls:
        ob["tls"] = tls
    tr = _transport(q.get("type"), q)
    if tr:
        ob["transport"] = tr
    return ob


def _ob_ss(uri):
    body, name = uri[5:], ""
    if "#" in body:
        body, name = body.split("#", 1)
        name = urllib.parse.unquote(name)
    if "?" in body:
        body, qstr = body.split("?", 1)
        if "plugin" in qstr:
            raise ValueError("ss 插件暂不支持")
    if "@" in body:
        userinfo, hostport = body.rsplit("@", 1)
        try:
            dec = _b64d(userinfo).decode("utf-8")
            if ":" not in dec:
                raise ValueError
        except Exception:
            dec = urllib.parse.unquote(userinfo)
    else:
        dec, hostport = _b64d(body).decode("utf-8").rsplit("@", 1)
    method, password = dec.split(":", 1)
    host, port = hostport.rsplit(":", 1)
    return {"type": "shadowsocks", "tag": name or "ss", "server": host.strip("[]"),
            "server_port": int(port), "method": method, "password": password}


def _ob_hy2(uri):
    u = urllib.parse.urlparse(uri)
    q = _qs(u)
    pw = urllib.parse.unquote(u.username or "")
    if u.password:
        pw += ":" + urllib.parse.unquote(u.password)
    ob = {"type": "hysteria2", "tag": urllib.parse.unquote(u.fragment) or "hysteria2",
          "server": u.hostname, "server_port": u.port or 443, "password": pw,
          "tls": {"enabled": True, "server_name": q.get("sni") or u.hostname,
                  "insecure": _truthy(q.get("insecure", ""))}}
    if q.get("alpn"):
        ob["tls"]["alpn"] = q["alpn"].split(",")
    if q.get("obfs"):
        ob["obfs"] = {"type": q["obfs"], "password": q.get("obfs-password", "")}
    return ob


def _ob_tuic(uri):
    u = urllib.parse.urlparse(uri)
    q = _qs(u)
    return {"type": "tuic", "tag": urllib.parse.unquote(u.fragment) or "tuic",
            "server": u.hostname, "server_port": u.port or 443,
            "uuid": urllib.parse.unquote(u.username or ""),
            "password": urllib.parse.unquote(u.password or ""),
            "congestion_control": q.get("congestion_control", "bbr"),
            "udp_relay_mode": q.get("udp_relay_mode", "native"),
            "tls": {"enabled": True, "server_name": q.get("sni") or u.hostname,
                    "alpn": (q.get("alpn") or "h3").split(","),
                    "insecure": _truthy(q.get("allow_insecure", "")) or _truthy(q.get("insecure", ""))}}


_CONVERTERS = {"vmess": _ob_vmess, "vless": _ob_vless, "trojan": _ob_trojan,
               "ss": _ob_ss, "hysteria2": _ob_hy2, "hy2": _ob_hy2, "tuic": _ob_tuic}


def uri_to_outbound(uri):
    scheme = uri.split("://", 1)[0].lower()
    fn = _CONVERTERS.get(scheme)
    if not fn:
        raise ValueError("不支持的协议: " + scheme)
    return fn(uri.strip())


def parse_subscription_text(text):
    t = text.strip()
    if re.search(r"^\s*proxies\s*:", t, re.M):
        raise ValueError("sing-box 内核暂不支持 Clash YAML 订阅，请换通用(base64)订阅或切换 mihomo")
    if "://" not in t:
        try:
            t = _b64d("".join(t.split())).decode("utf-8", "replace")
        except Exception:
            raise ValueError("订阅内容无法解析")
    return [x for x in re.split(r"\s+", t) if "://" in x]


def fetch_text(url):
    req = urllib.request.Request(url, headers={"User-Agent": "v2rayN/7.0"})
    with urllib.request.urlopen(req, timeout=30) as r:
        return r.read().decode("utf-8", "replace")


def _unique(tag, used):
    base, n = tag, 2
    while tag in used:
        tag = "%s #%d" % (base, n)
        n += 1
    used.add(tag)
    return tag


def build_singbox_config(sources, port, ctl_port, secret, home, force, groups=None):
    nodes, used, meta = [], {"PROXY", "AUTO", "direct"}, {}
    for i, s in enumerate(sources):
        pid = "s%d" % i
        value = str(s["value"]).strip()
        is_sub = _is_sub_url(value)
        err, uris = None, []
        try:
            if is_sub:
                cache = os.path.join(home, pid + ".sub")
                text = None
                if force or not os.path.exists(cache):
                    try:
                        text = fetch_text(value)
                        with open(cache, "w", encoding="utf-8") as f:
                            f.write(text)
                    except Exception as e:
                        if not os.path.exists(cache):
                            raise
                        err = "下载失败，使用缓存: %s" % e
                if text is None:
                    with open(cache, encoding="utf-8") as f:
                        text = f.read()
                uris = parse_subscription_text(text)
            else:
                uris = [x for x in re.split(r"\s+", value) if x]
        except Exception as e:
            err = str(e)
        count = 0
        for uri in uris:
            try:
                ob = uri_to_outbound(uri)
            except Exception:
                continue
            ob["tag"] = _unique(ob["tag"], used)
            nodes.append(ob)
            count += 1
        meta[pid] = {"name": s["name"], "kind": "sub" if is_sub else "links",
                     "count": count, "error": err}
    tags = [n["tag"] for n in nodes]
    if not tags:
        raise ValueError("sing-box 没有解析出任何可用节点")
    tag_set = set(tags)
    gout, gnames = [], []
    for g in groups or []:
        members = [n for n in g["nodes"] if n in tag_set]
        gt = "G:" + g["name"]
        if not members or gt in used:
            continue
        used.add(gt)
        gout.append({"type": "urltest", "tag": gt, "outbounds": members, "url": HC_URL,
                     "interval": "5m", "tolerance": 50})
        gnames.append(gt)
    cfg = {
        "log": {"level": "warn"},
        "dns": {"servers": [{"type": "udp", "tag": "dns-bootstrap", "server": "223.5.5.5"}],
                "final": "dns-bootstrap"},
        "inbounds": [{"type": "mixed", "tag": "in", "listen": "127.0.0.1",
                      "listen_port": int(port)}],
        "outbounds": nodes + gout + [
            {"type": "selector", "tag": "PROXY", "outbounds": ["AUTO"] + gnames + tags,
             "default": "AUTO"},
            {"type": "urltest", "tag": "AUTO", "outbounds": tags, "url": HC_URL,
             "interval": "5m", "tolerance": 50},
            {"type": "direct", "tag": "direct"},
        ],
        "route": {"final": "PROXY", "default_domain_resolver": "dns-bootstrap"},
        "experimental": {"clash_api": {
            "external_controller": "127.0.0.1:%d" % int(ctl_port), "secret": secret}},
    }
    return cfg, meta


# ---------- 核心自动获取与安装 ----------
def _http_get(url, timeout=60, proxy_port=0):
    """先直连；失败且本地代理在运行时，改走本地代理（HTTP）。"""
    req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0", "Accept": "*/*"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return r.read()
    except Exception:
        if not proxy_port:
            raise
        px = "http://127.0.0.1:%d" % proxy_port
        op = urllib.request.build_opener(urllib.request.ProxyHandler({"http": px, "https": px}))
        with op.open(req, timeout=timeout) as r:
            return r.read()


def _read_sha(assets, kind, proxy_port):
    for n in ("sha256-%s.txt" % kind, "sha256.txt"):
        if n in assets:
            try:
                return _http_get(assets[n], 30, proxy_port).decode().split()[0].strip().lower()
            except Exception:
                return ""
    return ""


def resolve_core(kind, proxy_port=0):
    """从项目 Releases 找到最新的该内核文件，返回 {tag, url, sha}。"""
    gz = CORES[kind]["file"] + ".gz"
    errors = []
    try:
        rels = json.loads(_http_get(
            "https://api.github.com/repos/%s/releases?per_page=30" % CORE_REPO,
            30, proxy_port).decode("utf-8"))
        for r in rels:
            if r.get("draft"):
                continue
            assets = {a["name"]: a["browser_download_url"] for a in r.get("assets", [])}
            if gz in assets:
                return {"tag": r.get("tag_name", ""), "url": assets[gz],
                        "sha": _read_sha(assets, kind, proxy_port)}
        errors.append("Releases 里没有 %s" % gz)
    except Exception as e:
        errors.append(str(e))
    # API 不可用时回退到固定的 latest 地址
    base = "https://github.com/%s/releases/latest/download/" % CORE_REPO
    sha = ""
    for n in ("sha256-%s.txt" % kind, "sha256.txt"):
        try:
            sha = _http_get(base + n, 30, proxy_port).decode().split()[0].strip().lower()
            break
        except Exception:
            continue
    if sha:
        return {"tag": "latest", "url": base + gz, "sha": sha}
    raise RuntimeError("获取核心信息失败: " + "; ".join(errors))


def install_core_bytes(data, sha256, dest):
    if data[:2] == b"\x1f\x8b":
        data = gzip.decompress(data)
    if len(data) < 1024 * 1024 or data[:4] != b"\x7fELF":
        raise RuntimeError("下载内容不是有效的 .so 文件")
    if (data[18] | (data[19] << 8)) != 183:
        raise RuntimeError("核心不是 arm64 版本")
    sha256 = str(sha256 or "").strip().lower()
    if sha256 and hashlib.sha256(data).hexdigest() != sha256:
        raise RuntimeError("SHA-256 校验失败")
    tmp = dest + ".tmp"
    with open(tmp, "wb") as f:
        f.write(data)
        f.flush()
        os.fsync(f.fileno())
    os.chmod(tmp, 0o700)
    os.replace(tmp, dest)
    return len(data)


def _load_lib(kind):
    global _LIB, _LIB_KIND, _LIB_FUNCS
    if _LIB is not None:
        if _LIB_KIND != kind:
            raise NeedRestart("同一进程里只能加载一种内核（当前已加载 %s）。"
                              "需要重启客户端后才能使用 %s。"
                              % (CORES[_LIB_KIND]["label"], CORES[kind]["label"]))
        return _LIB_FUNCS
    path = _core_path(kind)
    if not os.path.exists(path):
        raise RuntimeError("%s 核心未安装，请先在控制面板点击“安装组件”"
                           % CORES[kind]["label"])
    lib = ctypes.CDLL(path)
    p = CORES[kind]["prefix"]
    start, stop, last = (getattr(lib, p + "Start"), getattr(lib, p + "Stop"),
                         getattr(lib, p + "LastError"))
    start.argtypes = [ctypes.c_char_p, ctypes.c_char_p]
    start.restype = ctypes.c_int
    stop.argtypes = []
    stop.restype = None
    last.argtypes = []
    last.restype = ctypes.c_char_p
    _LIB, _LIB_KIND, _LIB_FUNCS = lib, kind, (start, stop, last)
    return _LIB_FUNCS


def restart_app():
    ctx = ApplicationLoader.applicationContext
    intent = ctx.getPackageManager().getLaunchIntentForPackage(ctx.getPackageName())
    if intent is not None:
        intent.addFlags(0x10000000 | 0x00008000)  # NEW_TASK | CLEAR_TASK
        pi = jclass("android.app.PendingIntent").getActivity(ctx, 0, intent,
                                                             0x08000000 | 0x04000000)
        am = cast(jclass("android.app.AlarmManager"), ctx.getSystemService("alarm"))
        am.set(0, jclass("java.lang.System").currentTimeMillis() + 800, pi)
    Process = jclass("android.os.Process")
    Process.killProcess(Process.myPid())


# ---------- 控制接口（两个内核都兼容 Clash API） ----------
class Api:
    def __init__(self, ctl_port, secret):
        self.base = "http://127.0.0.1:%d" % ctl_port
        self.secret = secret
        self.opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))

    def req(self, method, path, body=None, timeout=10):
        data = json.dumps(body).encode() if body is not None else None
        r = urllib.request.Request(self.base + path, data=data, method=method, headers={
            "Authorization": "Bearer " + self.secret, "Content-Type": "application/json"})
        try:
            with self.opener.open(r, timeout=timeout) as resp:
                raw = resp.read()
        except urllib.error.HTTPError as e:
            msg = None
            try:
                msg = json.loads(e.read().decode("utf-8", "replace")).get("message")
            except Exception:
                pass
            raise RuntimeError(msg or ("HTTP %d" % e.code))
        return json.loads(raw) if raw else None


# ---------- 对话框（和控制面板同一套圆角卡片风格） ----------
def _kit():
    act = None
    try:
        act = get_last_fragment().getParentActivity()
    except Exception:
        act = None
    if act is None:
        act = ApplicationLoader.applicationContext
    density = float(act.getResources().getDisplayMetrics().density)
    try:
        dark = bool(jclass("org.telegram.ui.ActionBar.Theme").isCurrentThemeDark())
    except Exception:
        dark = False
    return _Kit(act, density, _PAL_DARK if dark else _PAL_LIGHT)


def _show_card_dialog(title, message=None, body=None, buttons=(), scroll=True):
    """body: 函数(kit, dlg) -> View；buttons: [(文字, 样式, 回调, 字号)]，回调返回 False 时对话框保持打开。"""
    def show():
        try:
            k = _kit()
            act = k._act
            dm = act.getResources().getDisplayMetrics()
            sw, sh = int(dm.widthPixels), int(dm.heightPixels)
            width = int(sw * 0.9)
            inner = width - 2 * k._dp(22)
            dlg = jclass("android.app.Dialog")(act)
            dlg.requestWindowFeature(1)
            card = k._vbox()
            card.setPadding(k._dp(22), k._dp(22), k._dp(22), k._dp(16))
            card.setBackground(k._shape("card", 28, "stroke"))
            card.addView(k._text(title, 20, "text", True))

            def capped(view, cap):
                MS = jclass("android.view.View$MeasureSpec")
                view.measure(MS.makeMeasureSpec(inner, 1073741824), MS.makeMeasureSpec(0, 0))
                h = int(view.getMeasuredHeight())
                sc = jclass("android.widget.ScrollView")(act)
                sc.addView(view)
                sc.setLayoutParams(k._lp(-1, min(h, cap), m=(0, 10, 0, 4)))
                return sc

            if message:
                card.addView(capped(k._text(message, 14, "sub"), int(sh * 0.45)))
            if body is not None:
                view = body(k, dlg)
                if scroll:
                    card.addView(capped(view, int(sh * 0.5)))
                else:
                    view.setLayoutParams(k._lp(-1, -2, m=(0, 10, 0, 4)))
                    card.addView(view)

            def wrap(fn):
                def click():
                    keep = False
                    try:
                        keep = fn() is False
                    except Exception as e:
                        _toast(str(e))
                    if not keep:
                        dlg.dismiss()
                return click
            row = k._hbox()
            row.setLayoutParams(k._lp(-1, -2, m=(0, 12, 0, 0)))
            for btn in buttons:
                text, style, fn = btn[0], btn[1], btn[2]
                sp = btn[3] if len(btn) > 3 else 15
                row.addView(k._button(text, style, wrap(fn), h=44, weight=1, m=(4, 0, 4, 0), sp=sp))
            card.addView(row)
            dlg.setContentView(card)
            win = dlg.getWindow()
            win.setBackgroundDrawable(jclass("android.graphics.drawable.ColorDrawable")(0))
            win.setLayout(width, -2)
            win.setSoftInputMode(20)
            dlg.show()
        except Exception as e:
            _toast("无法显示对话框: %s" % e)
    run_on_ui_thread(show)


def list_dialog(title, labels, on_pick):
    def body(k, dlg):
        box = k._vbox()
        for i, label in enumerate(labels):
            tv = k._text(label, 16, "text", lines=3)
            tv.setPadding(k._dp(16), k._dp(14), k._dp(16), k._dp(14))
            tv.setBackground(k._shape("icon", 16))
            tv.setLayoutParams(k._lp(-1, -2, m=(0, 4, 0, 4)))
            tv.setClickable(True)
            tv.setOnClickListener(_VClick(
                (lambda idx: (lambda: (dlg.dismiss(), on_pick(idx))))(i)))
            box.addView(tv)
        return box
    _show_card_dialog(title, body=body, buttons=[("取消", "outline", lambda: None)])


def message_dialog(title, message, pos_text=None, on_pos=None):
    buttons = [("关闭", "outline", lambda: None)]
    if pos_text:
        buttons.append((pos_text, "primary", lambda: on_pos()))
    _show_card_dialog(title, message=message, buttons=buttons)


def multi_dialog(title, labels, checked, on_ok):
    """勾选对话框；“全选/清空”在原地切换，不会关闭对话框。"""
    state, rows, holder = list(checked), [], {}

    def paint(i):
        k, tv = holder["k"], rows[i]
        tv.setText(("☑  " if state[i] else "☐  ") + labels[i])
        tv.setBackground(k._shape("icon", 14) if state[i] else k._shape("card", 14, "stroke"))

    def body(k, dlg):
        holder["k"] = k
        box = k._vbox()
        for i in range(len(labels)):
            tv = k._text("", 15, "text", lines=2)
            tv.setPadding(k._dp(14), k._dp(12), k._dp(14), k._dp(12))
            tv.setLayoutParams(k._lp(-1, -2, m=(0, 3, 0, 3)))
            tv.setClickable(True)
            rows.append(tv)

            def toggle(idx=i):
                state[idx] = not state[idx]
                paint(idx)
            tv.setOnClickListener(_VClick(toggle))
            box.addView(tv)
            paint(i)
        return box

    def toggle_all():
        val = not all(state)
        for i in range(len(state)):
            state[i] = val
            paint(i)
        return False
    _show_card_dialog(title, body=body, buttons=[
        ("取消", "outline", lambda: None, 14),
        ("全选/清空", "outline", toggle_all, 14),
        ("保存", "primary", lambda: on_ok(list(state)), 14)])


def input_dialog(title, hints, values, on_ok, lines=None):
    """输入对话框；on_ok 返回 False 时保持打开（用于校验失败）。"""
    edits = []

    def body(k, dlg):
        box = k._vbox()
        for n, (hint, val) in enumerate(zip(hints, values)):
            e = jclass("android.widget.EditText")(k._act)
            e.setHint(hint)
            e.setText(val)
            e.setTextSize(15.0)
            e.setTextColor(k._c("text"))
            e.setHintTextColor(k._c("sub"))
            e.setBackground(k._shape("card", 14, "stroke"))
            e.setPadding(k._dp(14), k._dp(12), k._dp(14), k._dp(12))
            nl = (lines or [1] * len(hints))[n]
            if nl > 1:
                e.setMinLines(nl)
                e.setGravity(48)
            else:
                e.setSingleLine(True)
            e.setLayoutParams(k._lp(-1, -2, m=(0, 6, 0, 6)))
            edits.append(e)
            box.addView(e)
        return box
    _show_card_dialog(title, body=body, scroll=False, buttons=[
        ("取消", "outline", lambda: None),
        ("确定", "primary", lambda: on_ok([str(e.getText().toString()) for e in edits]))])


# ---------- Telegram 代理设置 ----------
def set_tg_proxy(enabled, host="", port=0, user="", pw="", secret=""):
    def work():
        try:
            if enabled and host:
                info = SharedConfig.ProxyInfo(host, port, user, pw, secret)
                SharedConfig.addProxy(info)
                SharedConfig.currentProxy = info
            ed = MessagesController.getGlobalMainSettings().edit()
            ed.putBoolean("proxy_enabled", bool(enabled))
            if host:
                ed.putString("proxy_ip", host)
                ed.putInt("proxy_port", int(port))
                ed.putString("proxy_user", user)
                ed.putString("proxy_pass", pw)
                ed.putString("proxy_secret", secret)
            ed.apply()
            ConnectionsManager.setProxySettings(bool(enabled), host, int(port), user, pw, secret)
            NotificationCenter.getGlobalInstance().postNotificationName(
                NotificationCenter.proxySettingsChanged)
        except Exception as e:
            _err("设置 Telegram 代理失败: %s" % e)
    run_on_ui_thread(work)


def read_tg_proxy():
    sp = MessagesController.getGlobalMainSettings()
    return {"e": bool(sp.getBoolean("proxy_enabled", False)),
            "ip": str(sp.getString("proxy_ip", "") or ""),
            "port": int(sp.getInt("proxy_port", 1080)),
            "u": str(sp.getString("proxy_user", "") or ""),
            "p": str(sp.getString("proxy_pass", "") or ""),
            "s": str(sp.getString("proxy_secret", "") or "")}


# ---------- 节点信息（协议 · 传输 · 加密），用于控制面板展示 ----------
_PROTO_NAMES = {"shadowsocks": "SS", "ss": "SS"}


def _ob_info(ob):
    proto = ob.get("type", "")
    tls = ob.get("tls")
    net = (ob.get("transport") or {}).get("type") or (
        "udp" if proto in ("hysteria2", "tuic") else "tcp")
    sec = "reality" if tls and tls.get("reality") else ("tls" if tls else "none")
    return {"proto": _PROTO_NAMES.get(proto, proto.upper()), "net": net, "sec": sec}


def _unq(v):
    v = str(v).strip()
    if len(v) >= 2 and v[0] == v[-1] and v[0] in "'\"":
        v = v[1:-1]
    return v


def _split_flow(text):
    parts, depth, quote, cur = [], 0, None, ""
    for ch in text:
        if quote:
            cur += ch
            if ch == quote:
                quote = None
        elif ch in "'\"":
            quote = ch
            cur += ch
        elif ch in "{[":
            depth += 1
            cur += ch
        elif ch in "}]":
            depth -= 1
            cur += ch
        elif ch == "," and depth == 0:
            parts.append(cur)
            cur = ""
        else:
            cur += ch
    parts.append(cur)
    return parts


def _clash_info(d):
    t = str(d.get("type", "")).lower()
    udp = t in ("hysteria", "hysteria2", "tuic")
    if "reality-opts" in d:
        sec = "reality"
    elif str(d.get("tls", "")).lower() == "true" or t in ("trojan", "hysteria", "hysteria2", "tuic"):
        sec = "tls"
    else:
        sec = "none"
    return {"proto": _PROTO_NAMES.get(t, t.upper()),
            "net": d.get("network") or ("udp" if udp else "tcp"), "sec": sec}


def _clash_infos(text):
    """很简化的 Clash YAML 扫描：只取 proxies 段里每个节点的 name/type/network/tls。"""
    out, cur, cur_indent, in_proxies = [], None, 0, False
    for raw in text.splitlines():
        line = raw.rstrip()
        st = line.strip()
        if not st or st.startswith("#"):
            continue
        if re.match(r"^proxies\s*:", line):
            in_proxies = True
            continue
        if not in_proxies:
            continue
        if re.match(r"^[A-Za-z][\w-]*\s*:", line):  # 下一个顶层字段，proxies 段结束
            break
        m = re.match(r"^\s*-\s*\{(.*)\}\s*$", line)
        if m:
            d = {}
            for part in _split_flow(m.group(1)):
                if ":" in part:
                    k, v = part.split(":", 1)
                    d[k.strip()] = _unq(v)
            if d.get("name"):
                out.append((d["name"], _clash_info(d)))
            cur = None
            continue
        m = re.match(r"^(\s*)-\s+([\w-]+)\s*:\s*(.*)$", line)
        if m:
            cur = {m.group(2): _unq(m.group(3))}
            cur_indent = len(m.group(1)) + 2
            out.append(cur)
            continue
        if cur is not None:
            m = re.match(r"^(\s+)([\w-]+)\s*:\s*(.*)$", line)
            if m and len(m.group(1)) == cur_indent:
                cur[m.group(2)] = _unq(m.group(3))
    result = []
    for x in out:
        if isinstance(x, tuple):
            result.append(x)
        elif x.get("name"):
            result.append((x["name"], _clash_info(x)))
    return result


def node_infos_from_text(text):
    if re.search(r"^\s*proxies\s*:", text, re.M):
        return _clash_infos(text)
    out = []
    try:
        uris = parse_subscription_text(text)
    except Exception:
        uris = []
    for u in uris:
        try:
            ob = uri_to_outbound(u)
            out.append((ob["tag"], _ob_info(ob)))
        except Exception:
            continue
    return out


# ---------- 控制面板用到的 Android 视图工具 ----------
_PAL_LIGHT = {"bg": "#F0F1F3", "card": "#FFFFFF", "stroke": "#DADADA", "text": "#202124",
              "sub": "#7A7F85", "blue": "#4A98E8", "icon": "#EAF2F8", "accent": "#4F8FCB",
              "outline": "#BFD6EA", "ok": "#2E9B5F", "warn": "#E0902B", "bad": "#D9534F",
              "off": "#8A9099"}
_PAL_DARK = {"bg": "#121212", "card": "#1E1F22", "stroke": "#3A3B3E", "text": "#E8EAED",
             "sub": "#9AA0A6", "blue": "#4A98E8", "icon": "#263340", "accent": "#7FB2E5",
             "outline": "#3F5B78", "ok": "#5DC98A", "warn": "#F0AE55", "bad": "#EE7B72",
             "off": "#9AA0A6"}

_ViewClickIface = jclass("android.view.View$OnClickListener")
_DismissIface = jclass("android.content.DialogInterface$OnDismissListener")
_RunnableIface = jclass("java.lang.Runnable")


class _VClick(dynamic_proxy(_ViewClickIface)):
    def __init__(self, fn):
        super().__init__()
        self._fn = fn

    def onClick(self, v):
        try:
            self._fn()
        except Exception:
            pass


class _Dismiss(dynamic_proxy(_DismissIface)):
    def __init__(self, fn):
        super().__init__()
        self._fn = fn

    def onDismiss(self, d):
        try:
            self._fn()
        except Exception:
            pass


class _Run(dynamic_proxy(_RunnableIface)):
    def __init__(self, fn):
        super().__init__()
        self._fn = fn

    def run(self):
        try:
            self._fn()
        except Exception:
            pass


_CheckIface = jclass("android.widget.CompoundButton$OnCheckedChangeListener")


class _Check(dynamic_proxy(_CheckIface)):
    def __init__(self, fn):
        super().__init__()
        self._fn = fn

    def onCheckedChanged(self, button, checked):
        try:
            self._fn(bool(checked))
        except Exception:
            pass


# ---------- 视图工具（控制面板和对话框共用） ----------
class _UiMixin:
    """依赖 self._act / self._density / self._pal。"""

    def _dp(self, v):
        return int(v * self._density + 0.5)

    def _c(self, key):
        return jclass("android.graphics.Color").parseColor(self._pal[key])

    def _shape(self, fill, radius, stroke=None, oval=False, sw=1):
        gd = jclass("android.graphics.drawable.GradientDrawable")()
        if oval:
            gd.setShape(1)
        else:
            gd.setCornerRadius(float(self._dp(radius)))
        gd.setColor(self._c(fill))
        if stroke:
            gd.setStroke(self._dp(sw), self._c(stroke))
        return gd

    def _lp(self, w, h, weight=None, m=(0, 0, 0, 0)):
        LP = jclass("android.widget.LinearLayout$LayoutParams")
        lp = LP(w, h, float(weight)) if weight is not None else LP(w, h)
        lp.setMargins(*[self._dp(x) for x in m])
        return lp

    def _text(self, text, sp, color, bold=False, lines=0):
        tv = jclass("android.widget.TextView")(self._act)
        tv.setText(str(text))
        tv.setTextSize(float(sp))
        tv.setTextColor(self._c(color))
        if bold:
            tv.setTypeface(jclass("android.graphics.Typeface").DEFAULT_BOLD)
        if lines:
            tv.setMaxLines(lines)
            tv.setEllipsize(jclass("android.text.TextUtils$TruncateAt").END)
        return tv

    def _vbox(self):
        b = jclass("android.widget.LinearLayout")(self._act)
        b.setOrientation(1)
        return b

    def _hbox(self, gravity=16):
        b = jclass("android.widget.LinearLayout")(self._act)
        b.setOrientation(0)
        b.setGravity(gravity)
        return b

    def _card(self, selected=False, on_click=None, compact=False, pad=20):
        c = self._vbox()
        d = self._dp(14 if compact else pad)
        c.setPadding(d, d, d, d)
        c.setBackground(self._shape("card", 22 if compact else 28, "blue" if selected else "stroke",
                                    sw=2 if selected else 1))
        if compact:  # 双列：两张卡片各占一半
            c.setLayoutParams(self._lp(0, -2, weight=1, m=(6, 6, 6, 6)))
        else:
            c.setLayoutParams(self._lp(-1, -2, m=(12, 6, 12, 6)))
        if on_click:
            c.setClickable(True)
            c.setOnClickListener(_VClick(on_click))
        return c

    def _icon(self, size=64, sp=22):
        ic = jclass("android.widget.TextView")(self._act)
        ic.setText("▶\uFE0E")
        ic.setTextSize(float(sp))
        ic.setTextColor(self._c("accent"))
        ic.setGravity(17)
        ic.setBackground(self._shape("icon", 0, oval=True))
        ic.setLayoutParams(self._lp(self._dp(size), self._dp(size)))
        return ic

    def _small_button(self, text, fn):
        """放在卡片末尾的小按钮。"""
        b = jclass("android.widget.TextView")(self._act)
        b.setText(str(text))
        b.setTextSize(12.0)
        b.setGravity(17)
        b.setTypeface(jclass("android.graphics.Typeface").DEFAULT_BOLD)
        b.setPadding(self._dp(14), 0, self._dp(14), 0)
        b.setBackground(self._shape("card", 17, "outline", sw=1))
        b.setTextColor(self._c("accent"))
        b.setClickable(True)
        b.setOnClickListener(_VClick(fn))
        b.setLayoutParams(self._lp(-2, self._dp(34), m=(8, 0, 0, 0)))
        return b

    def _button(self, text, style, fn, h=52, weight=None, m=(0, 16, 0, 0), sp=16):
        b = jclass("android.widget.TextView")(self._act)
        b.setText(str(text))
        b.setGravity(17)
        b.setTextSize(float(sp))
        b.setTypeface(jclass("android.graphics.Typeface").DEFAULT_BOLD)
        r = h // 2
        if style == "primary":
            b.setBackground(self._shape("blue", r))
            b.setTextColor(jclass("android.graphics.Color").WHITE)
        elif style == "gray":
            b.setBackground(self._shape("off", r))
            b.setTextColor(jclass("android.graphics.Color").WHITE)
        else:
            b.setBackground(self._shape("card", r, "outline", sw=2))
            b.setTextColor(self._c("accent"))
        b.setClickable(True)
        b.setOnClickListener(_VClick(fn))
        b.setLayoutParams(self._lp(-1 if weight is None else 0, self._dp(h), weight=weight, m=m))
        return b

    def _badge(self, text):
        """卡片标题旁的小徽标，例如“使用中”。"""
        b = jclass("android.widget.TextView")(self._act)
        b.setText(str(text))
        b.setTextSize(11.0)
        b.setGravity(17)
        b.setTypeface(jclass("android.graphics.Typeface").DEFAULT_BOLD)
        b.setTextColor(jclass("android.graphics.Color").WHITE)
        b.setPadding(self._dp(8), self._dp(2), self._dp(8), self._dp(2))
        b.setBackground(self._shape("blue", 10))
        b.setLayoutParams(self._lp(-2, -2, m=(8, 0, 0, 0)))
        return b


class _Kit(_UiMixin):
    def __init__(self, act, density, pal):
        self._act, self._density, self._pal = act, density, pal


# ---------- 插件 ----------
class ProxyCorePlugin(_UiMixin, BasePlugin):
    def __init__(self):
        super().__init__()
        self._lock = threading.Lock()
        self._started = False
        self._running_kind = None
        self._port = 0
        self._api = None
        self._meta = {}
        self._menu_ids = []
        # 控制面板
        self._dlg = None
        self._content = None
        self._scroll = None
        self._act = None
        self._density = 3.0
        self._pal = _PAL_LIGHT
        self._busy = ""
        self._snap = None
        self._delay = {}
        self._delay_views = {}
        self._info_cache = {}
        self._keep = []
        self._poll_token = None
        self._last_reload = 0.0

    # --- 生命周期 ---
    def on_plugin_load(self):
        self._register_menu()
        if _as_bool(self.get_setting("enabled", False)):
            self._run_async(self._start, quiet=True)

    def on_plugin_unload(self):
        for i in list(self._menu_ids):
            try:
                self.remove_menu_item(i)
            except Exception:
                pass
        self._menu_ids = []
        try:
            if self._dlg is not None:
                run_on_ui_thread(lambda: self._dlg.dismiss())
        except Exception:
            pass
        try:
            self._stop(restore_tg=True)
        except Exception as e:
            self.log("ProxyCore unload: %s" % e)

    def _register_menu(self):
        if MenuItemData is None or MenuItemType is None:
            return
        for item_id, text, fn in (
                ("proxy_core_panel", "代理控制面板", self._open_dashboard),
                ("proxy_core_stop", "停止代理内核", self._manual_stop)):
            try:
                self.remove_menu_item(item_id)
            except Exception:
                pass
            try:
                self.add_menu_item(MenuItemData(
                    menu_type=MenuItemType.DRAWER_MENU, text=text,
                    on_click=(lambda f: (lambda *_: self._run_async(f)))(fn),
                    item_id=item_id, icon="msg_language", priority=1))
                self._menu_ids.append(item_id)
            except Exception as e:
                self.log("ProxyCore menu: %s" % e)

    # --- 当前内核 ---
    def _kind(self):
        k = str(self.get_setting("core_type", "mihomo"))
        return k if k in CORES else "mihomo"

    # --- 设置页 ---
    # ---------- 设置页 ----------
    def _set(self, key, value, reload=False):
        try:
            self.set_setting(key, value, reload_settings=reload)
        except TypeError:
            self.set_setting(key, value)

    def _reload_settings(self, force=False):
        """让设置页重建，刷新“正在使用的节点”卡片（带节流，避免反复重建）。"""
        now = time.time()
        if not force and now - self._last_reload < 2.0:
            return
        self._last_reload = now
        try:
            self._set("ui_tick", str(int(now)), reload=True)
        except Exception as e:
            self.log("reload settings: %s" % e)

    @staticmethod
    def _mk(cls, **kw):
        """不同客户端的设置项参数可能不同：不认识 subtext / icon 时去掉再试。"""
        try:
            return cls(**kw)
        except TypeError:
            kw.pop("subtext", None)
            kw.pop("icon", None)
            return cls(**kw)

    def create_settings(self):
        items = []
        card = self._settings_card_item()
        if card is not None:
            items += [card, Divider()]
        else:  # 客户端不支持自定义行时的退路
            items += [Header(text="控制面板"),
                      Text(text="打开控制面板（安装 / 连接 / 选节点）", icon="msg_settings",
                           accent=True, on_click=lambda *_: self._open_dashboard())]
        items.append(Text(text="停止内核（恢复原有代理设置）", icon="msg_pause", accent=True,
                          on_click=lambda *_: self._run_async(self._manual_stop)))
        items.append(Header(text="运行"))
        items += self._settings_run_items()
        return items

    # --- “正在使用的节点”卡片 ---
    def _summary_texts(self, snap):
        """返回 (标题, 标题颜色, 第二行, 第三行)。"""
        kind = self._kind()
        label = CORES[kind]["label"]
        installed = os.path.exists(_core_path(kind))
        running = bool(snap and snap.get("running"))
        active = (snap or {}).get("active", "")
        if running and active:
            info = next((n["info"] for n in snap["nodes"] if n["name"] == active), None)
            line2 = ("%s · %s · %s" % (info["proto"], info["net"], info["sec"])) if info \
                else "%s · 127.0.0.1:%d" % (label, snap["port"])
            d = self._delay.get(active)
            now = snap.get("now", "")
            via = "（自动选择）" if now == "AUTO" else ("（分组自动选择）" if now.startswith("G:") else "")
            line3 = (("%d ms · " % d) if isinstance(d, int) and d > 0 else "") + "使用中" + via
            return active, "text", line2, line3
        if running:
            return "已连接", "text", "%s · 127.0.0.1:%d" % (label, snap["port"]), "点击打开控制面板"
        if not installed:
            return "尚未安装组件", "off", "点击打开控制面板，一键安装", "断开连接"
        return "断开连接", "off", "%s 已就绪" % label, "点击打开控制面板连接"

    def _settings_card_item(self):
        if Custom is None:
            return None
        try:
            k = _kit()
            snap = self._snap
            if snap is None:
                try:
                    snap = self._collect()
                except Exception:
                    snap = None
            title, tcolor, line2, line3 = self._summary_texts(snap)
            root = k._hbox()
            root.setPadding(k._dp(16), k._dp(14), k._dp(16), k._dp(14))
            root.addView(k._icon(56, 20))
            col = k._vbox()
            col.setPadding(k._dp(14), 0, 0, 0)
            col.setLayoutParams(k._lp(0, -2, weight=1))
            col.addView(k._text(title, 17, tcolor, True, lines=2))
            col.addView(k._text(line2, 13, "accent", lines=1))
            col.addView(k._text(line3, 13, "sub", lines=1))
            root.addView(col)
            root.addView(k._text("›", 26, "sub"))
            root.setClickable(True)
            root.setOnClickListener(_VClick(lambda: self._open_dashboard()))
            root.setLayoutParams(jclass("android.view.ViewGroup$LayoutParams")(-1, -2))
            return Custom(view=root)
        except Exception as e:
            self.log("settings card: %s" % e)
            return None

    # --- “运行”下的两项 ---
    @staticmethod
    def _setting_row(k, title, sub, right):
        row = k._hbox()
        row.setPadding(k._dp(16), k._dp(12), k._dp(16), k._dp(12))
        col = k._vbox()
        col.setLayoutParams(k._lp(0, -2, weight=1))
        col.addView(k._text(title, 16, "text"))
        col.addView(k._text(sub, 12, "sub", lines=2))
        row.addView(col)
        row.addView(right)
        row.setLayoutParams(jclass("android.view.ViewGroup$LayoutParams")(-1, -2))
        return row

    def _settings_run_items(self):
        port = str(self.get_setting("port", "17891"))
        auto = _as_bool(self.get_setting("enabled", False))
        if Custom is not None:
            try:
                k = _kit()
                pill = k._small_button(port, lambda: self._edit_port())
                sw = jclass("android.widget.Switch")(k._act)
                sw.setChecked(bool(auto))
                sw.setOnCheckedChangeListener(_Check(self._on_auto))
                return [
                    Custom(view=self._setting_row(k, "本地端口", "被占用时自动顺延，点击右侧修改", pill)),
                    Custom(view=self._setting_row(k, "自动连接", "随客户端启动时自动连接（记住上次状态）", sw)),
                ]
            except Exception as e:
                self.log("settings rows: %s" % e)
        return [
            self._mk(Input, key="port", text="本地端口", subtext="被占用时自动顺延",
                     icon="msg_language", default=port,
                     on_change=lambda v: self.set_setting("port", v)),
            self._mk(Switch, key="enabled", text="自动连接",
                     subtext="随客户端启动时自动连接（记住上次状态）", icon="msg_retry",
                     default=bool(auto),
                     on_change=lambda v: self.set_setting("enabled", bool(v))),
        ]

    def _on_auto(self, value):
        self._set("enabled", bool(value), reload=False)

    def _edit_port(self):
        def ok(vals):
            v = vals[0].strip()
            if not v.isdigit() or not (1024 <= int(v) <= 65000):
                _toast("端口需为 1024–65000 的数字")
                return False
            self._set("port", v, reload=True)  # 重建设置页，让按钮显示新端口
            _toast("端口已保存，重新连接后生效")
        input_dialog("本地端口", ["端口（1024–65000）"],
                     [str(self.get_setting("port", "17891"))], ok)

    # --- 订阅数据 ---
    def _load_sources(self):
        try:
            raw = json.loads(self.get_setting("sources", "[]") or "[]")
        except Exception:
            raw = []
        out = []
        for x in raw if isinstance(raw, list) else []:
            if isinstance(x, dict) and str(x.get("value", "")).strip():
                out.append({"name": str(x.get("name", "")), "value": str(x["value"]).strip()})
        if not out:  # 迁移旧版输入框
            old = str(self.get_setting("nodes", "") or "").strip()
            if old:
                items = [x for x in re.split(r"[\s|]+", old) if x]
                links = [x for x in items if not _is_sub_url(x)]
                for u in [x for x in items if _is_sub_url(x)]:
                    out.append({"name": _default_name(u, len(out) + 1), "value": u})
                if links:
                    out.append({"name": "手动节点", "value": "\n".join(links)})
                self._save_sources(out)
                self.set_setting("nodes", "")
        return out

    def _save_sources(self, sources):
        self.set_setting("sources", json.dumps(sources, ensure_ascii=False))

    # --- 订阅管理界面 ---
    def _manage(self):
        def build():
            srcs = self._load_sources()
            labels = ["＋ 添加订阅 / 节点链接"]
            labels += ["%s  ·  %s" % (s["name"] or "未命名", _short(s["value"])) for s in srcs]
            if srcs:
                labels.append("🗑 清空全部")

            def pick(i):
                if i == 0:
                    self._edit_source(None)
                elif i <= len(srcs):
                    self._source_menu(i - 1)
                else:
                    self._save_and_apply([], "已清空所有订阅")
            list_dialog("订阅管理 (%d)" % len(srcs), labels, pick)
        threading.Thread(target=build, daemon=True).start()

    def _source_menu(self, idx):
        srcs = self._load_sources()
        if idx >= len(srcs):
            return

        def pick(i):
            if i == 0:
                self._edit_source(idx)
            else:
                cur = self._load_sources()
                if idx < len(cur):
                    removed = cur.pop(idx)
                    self._save_and_apply(cur, "已删除: " + (removed["name"] or "订阅"))
        list_dialog(srcs[idx]["name"] or "订阅", ["编辑", "删除"], pick)

    def _edit_source(self, idx):
        srcs = self._load_sources()
        cur = srcs[idx] if idx is not None and idx < len(srcs) else {"name": "", "value": ""}

        def ok(vals):
            name, value = vals[0].strip(), vals[1].strip()
            if not value:
                _toast("订阅地址或节点链接不能为空")
                return False
            lst = self._load_sources()
            item = {"name": name or _default_name(value, len(lst) + 1), "value": value}
            if idx is not None and idx < len(lst):
                lst[idx] = item
            else:
                lst.append(item)
            self._save_and_apply(lst, "已保存: " + item["name"])
        input_dialog("编辑订阅" if idx is not None else "添加订阅",
                     ["名称（可选）", "订阅地址 或 节点链接（可多条，空格/换行分隔）"],
                     [cur["name"], cur["value"]], ok, lines=[1, 4])

    def _save_and_apply(self, sources, tip):
        def go():
            self._save_sources(sources)
            _info(tip)
            try:
                if sources and self._started:
                    self._refresh()
                elif not sources and self._started:
                    self._stop(restore_tg=True)
            except Exception as e:
                _err(str(e))
            self._ui_refresh()
        threading.Thread(target=go, name="proxy-core", daemon=True).start()

    # --- 通用 ---
    def _run_async(self, fn, quiet=False):
        def go():
            try:
                fn()
            except NeedRestart as e:
                self._ask_restart(str(e))
            except Exception as e:
                self.log("ProxyCore: %s" % e)
                _err(("内核启动失败: %s" % e) if quiet else str(e))
        threading.Thread(target=go, name="proxy-core", daemon=True).start()

    def _ask_restart(self, text):
        message_dialog("需要重启客户端", text, "立即重启客户端", restart_app)

    # --- 内核切换与安装 ---
    def _choose_core(self):
        cur = self._kind()
        keys = list(CORES)
        labels = [CORES[k]["label"] + ("  ✔" if k == cur else "") +
                  ("" if os.path.exists(_core_path(k)) else "（未安装）") for k in keys]

        def pick(i):
            new = keys[i]
            if new == cur:
                return

            def go():
                try:
                    self._stop(restore_tg=True)  # 先停掉旧内核，避免两个内核同时占用
                    self.set_setting("core_type", new)
                    if _LIB is not None and _LIB_KIND != new:
                        self._ask_restart("已切换到 %s。同一进程里只能加载一种内核，"
                                          "请重启客户端后再点“启动内核”。" % CORES[new]["label"])
                    else:
                        _info("已切换到 %s，请确认已安装核心后点“启动内核”" % CORES[new]["label"])
                except NeedRestart as e:
                    self._ask_restart(str(e))
            threading.Thread(target=go, daemon=True).start()
        list_dialog("选择内核", labels, pick)

    def _install_or_update(self, kind, force=False):
        """从项目 Releases 获取最新核心并安装；已是最新则跳过。"""
        label = CORES[kind]["label"]
        pp = self._port if self._started else 0
        _info("正在查询最新的 %s 核心…" % label)
        rel = resolve_core(kind, pp)
        dest = _core_path(kind)
        cur = str(self.get_setting("core_tag_" + kind, "") or "")
        if (not force and os.path.exists(dest) and cur and rel["tag"] != "latest"
                and cur == rel["tag"]):
            _info("%s 核心已是最新版本（%s）" % (label, cur))
            return
        _info("正在下载 %s 核心（%s）…" % (label, rel["tag"]))
        data = _http_get(rel["url"], 300, pp)
        n = install_core_bytes(data, rel["sha"], dest)
        self.set_setting("core_tag_" + kind, rel["tag"])
        loaded = _LIB is not None and _LIB_KIND == kind
        _info("%s 核心安装完成 %.1f MB（%s）" % (label, n / 1048576.0, rel["tag"]))
        if loaded:
            raise NeedRestart("%s 核心已更新，但旧版本仍在运行中，重启客户端后才会使用新版本。" % label)

    # --- 启停 ---
    def _manual_start(self):
        self.set_setting("enabled", True)
        self._start()
        _info("%s 已启动 127.0.0.1:%d" % (CORES[self._running_kind]["label"], self._port))

    def _manual_stop(self):
        was = self._started
        self._stop(restore_tg=True)
        self.set_setting("enabled", False)
        _info("内核已停止，Telegram 代理设置已恢复" if was else "内核当前没有运行")

    def _stop_locked(self):
        if _LIB_FUNCS is not None and self._started:
            try:
                _LIB_FUNCS[1]()
            except Exception as e:
                self.log("ProxyCore stop: %s" % e)
        self._started = False
        self._api = None

    def _stop(self, restore_tg):
        with self._lock:
            self._stop_locked()
        if restore_tg:
            self._restore_tg_proxy()
        self._ui_refresh()

    def _save_prev_proxy(self):
        if self.get_setting("prev_proxy", ""):
            return
        try:
            prev = read_tg_proxy()
            if prev["e"] and prev["ip"] == "127.0.0.1":
                prev["e"] = False  # 上次异常退出残留的本插件代理，不当作原设置
            self.set_setting("prev_proxy", json.dumps(prev))
        except Exception as e:
            self.log("save prev proxy: %s" % e)

    def _restore_tg_proxy(self):
        raw = self.get_setting("prev_proxy", "")
        prev = None
        try:
            prev = json.loads(raw) if raw else None
        except Exception:
            prev = None
        if prev:
            set_tg_proxy(prev["e"], prev["ip"], prev["port"], prev["u"], prev["p"], prev["s"])
            self.set_setting("prev_proxy", "")
        else:
            set_tg_proxy(False)

    def _start(self, force=False):
        with self._lock:
            kind = self._kind()
            sources = self._load_sources()
            if not sources:
                raise RuntimeError("还没有添加订阅或节点，请先在“订阅管理”里添加")
            funcs = _load_lib(kind)  # 未安装 / 需重启会在这里抛出
            self._stop_locked()  # 先停掉自己正在运行的实例，再选端口
            want = int(str(self.get_setting("port", "17891")).strip())
            port, ctl_port = pick_ports(want)
            home = _home()
            secret = os.urandom(8).hex()
            groups = self._groups_for_config(set(self._scan_node_infos()))
            if kind == "mihomo":
                cfg, meta = build_mihomo_config(sources, port, ctl_port, secret, home, groups)
            else:
                cfg, meta = build_singbox_config(sources, port, ctl_port, secret, home, force, groups)
            cfg_path = os.path.join(home, "config_%s.json" % kind)
            with open(cfg_path, "w", encoding="utf-8") as f:
                json.dump(cfg, f, ensure_ascii=False)
            rc = funcs[0](home.encode(), cfg_path.encode())
            if rc != 0:
                msg = (funcs[2]() or b"").decode("utf-8", "replace")
                raise RuntimeError("内核启动失败(%d): %s" % (rc, msg))
            deadline = time.time() + 12
            while time.time() < deadline:
                try:
                    socket.create_connection(("127.0.0.1", port), 0.5).close()
                    break
                except OSError:
                    time.sleep(0.3)
            else:
                funcs[1]()
                raise RuntimeError("本地端口 %d 未就绪" % port)
            self._started, self._running_kind, self._port = True, kind, port
            self._api = Api(ctl_port, secret)
            self._meta = meta
            self._save_prev_proxy()
            set_tg_proxy(True, "127.0.0.1", port)
            self._delay = {}
            self._restore_pick()
            if port != want:
                _info("端口 %d 被占用，已改用 %d" % (want, port))
        self._ui_refresh()

    def _ensure_running(self):
        if not self._started or self._api is None:
            self._start()
        return self._api

    # --- 订阅更新与节点选择 ---
    def _refresh(self):
        kind = self._kind()
        self._start(force=True)  # sing-box 会重新下载订阅；mihomo 在下面强制更新
        api = self._api
        lines, total = [], 0
        for pid, m in self._meta.items():
            name = m["name"] or pid
            error, count = m.get("error"), m.get("count")
            if kind == "mihomo":
                error = None
                if m["kind"] == "sub":
                    try:
                        api.req("PUT", "/providers/proxies/" + _q(pid), timeout=60)
                    except Exception as e:
                        error = str(e)
                try:
                    data = api.req("GET", "/providers/proxies/" + _q(pid)) or {}
                    count = len(data.get("proxies") or [])
                except Exception as e:
                    count = 0
                    error = error or str(e)
            total += count or 0
            if count:
                lines.append("✔ %s：%d 个节点%s" % (name, count, ("（%s）" % error) if error else ""))
            else:
                lines.append("✘ %s：0 个节点%s" % (name, ("，" + error) if error else "，订阅内容无法解析或为空"))
        text = "\n".join(lines) + "\n\n共 %d 个节点" % total
        self._ui_refresh()
        if total:
            if _DASH_OPEN:  # 面板已经打开，节点列表会自动刷新
                message_dialog("订阅更新结果", text)
            else:
                message_dialog("订阅更新结果", text, "打开控制面板", self._open_dashboard)
        else:
            message_dialog("订阅更新结果", text)

    @staticmethod
    def _node_names(api):
        data = api.req("GET", "/proxies/PROXY") or {}
        return [n for n in (data.get("all") or []) if n not in ("AUTO", "DIRECT", "direct")]

    @staticmethod
    def _delays(api, names):
        try:
            d = api.req("GET", "/group/AUTO/delay?url=%s&timeout=5000" % _q(HC_URL), timeout=30)
            if isinstance(d, dict) and d:
                return d
        except Exception:
            pass
        res = {}

        def one(n):
            try:
                r = api.req("GET", "/proxies/%s/delay?url=%s&timeout=5000" % (_q(n), _q(HC_URL)),
                            timeout=10)
                res[n] = int((r or {}).get("delay", 0))
            except Exception:
                res[n] = 0
        with ThreadPoolExecutor(max_workers=16) as ex:
            list(ex.map(one, names))
        return res

    # --- 打开 / 刷新 ---
    def _open_dashboard(self):
        def build():
            global _DASH_OPEN
            try:
                if self._dlg is not None:
                    try:
                        self._dlg.dismiss()
                    except Exception:
                        pass
                act = get_last_fragment().getParentActivity()
                self._act = act
                self._density = float(act.getResources().getDisplayMetrics().density)
                try:
                    dark = bool(jclass("org.telegram.ui.ActionBar.Theme").isCurrentThemeDark())
                except Exception:
                    dark = False
                self._pal = _PAL_DARK if dark else _PAL_LIGHT
                dlg = jclass("android.app.Dialog")(
                    act, jclass("android.R$style").Theme_DeviceDefault_NoActionBar)
                root = self._vbox()
                root.setBackgroundColor(self._c("bg"))
                try:
                    top = int(jclass("org.telegram.messenger.AndroidUtilities").statusBarHeight)
                except Exception:
                    top = self._dp(28)
                root.setPadding(0, top, 0, 0)
                bar = self._hbox()
                bar.setPadding(self._dp(20), self._dp(12), self._dp(20), self._dp(8))
                title = self._text("Proxy Core", 22, "text", True)
                title.setLayoutParams(self._lp(0, -2, weight=1))
                close = self._text("关闭", 16, "accent", True)
                close.setPadding(self._dp(8), self._dp(8), self._dp(8), self._dp(8))
                close.setClickable(True)
                close.setOnClickListener(_VClick(lambda: dlg.dismiss()))
                bar.addView(title)
                bar.addView(close)
                scroll = jclass("android.widget.ScrollView")(act)
                content = self._vbox()
                content.setPadding(0, 0, 0, self._dp(40))
                scroll.addView(content)
                root.addView(bar)
                root.addView(scroll, self._lp(-1, 0, weight=1))
                dlg.setContentView(root)
                win = dlg.getWindow()
                win.setBackgroundDrawable(
                    jclass("android.graphics.drawable.ColorDrawable")(self._c("bg")))
                win.setLayout(-1, -1)
                dismiss = _Dismiss(self._on_dismiss)
                self._keep = [dismiss]
                dlg.setOnDismissListener(dismiss)
                self._dlg, self._content, self._scroll = dlg, content, scroll
                _DASH_OPEN = True
                dlg.show()
                self._ui_refresh()
                tok = object()
                self._poll_token = tok
                threading.Thread(target=self._poll, args=(tok,), name="proxy-core-poll",
                                 daemon=True).start()
            except Exception as e:
                self.log("dashboard: %s" % e)
                _err("无法打开控制面板: %s" % e)
        run_on_ui_thread(build)

    def _on_dismiss(self):
        global _DASH_OPEN
        _DASH_OPEN = False
        self._poll_token = None
        self._dlg = self._content = self._scroll = None
        self._reload_settings(force=True)

    def _poll(self, token):
        """自动选择会随测速切换节点；只在“使用中的节点”变化时才重绘，避免打断滚动。"""
        while True:
            time.sleep(8)
            if self._dlg is None or self._poll_token is not token:
                return
            if self._busy or not self._started:
                continue
            try:
                snap = self._collect()
                old = self._snap or {}
                keys = ("active", "now", "running")
                if any(snap.get(x) != old.get(x) for x in keys):
                    run_on_ui_thread(lambda sn=snap: self._render(sn))
            except Exception as e:
                self.log("poll: %s" % e)

    def _ui_refresh(self):
        def go():
            try:
                snap = self._collect()
                self._snap = snap
                if self._dlg is not None:
                    run_on_ui_thread(lambda: self._render(snap))
                else:  # 面板没开：刷新设置页上的节点卡片
                    self._reload_settings()
            except Exception as e:
                self.log("dashboard refresh: %s" % e)
        threading.Thread(target=go, name="proxy-core-ui", daemon=True).start()

    # --- 数据 ---
    def _scan_node_infos(self):
        home, out = _home(), {}
        if len(self._info_cache) > 16:
            self._info_cache = {}
        for i, src in enumerate(self._load_sources()):
            value, infos = src["value"], []
            try:
                if _is_sub_url(value):
                    paths = [os.path.join(home, "s%d.%s" % (i, e)) for e in ("sub", "yaml")]
                    paths = [x for x in paths if os.path.exists(x)]
                    if not paths:
                        continue
                    path = max(paths, key=os.path.getmtime)
                    key = (path, os.path.getmtime(path))
                    if key not in self._info_cache:
                        with open(path, encoding="utf-8", errors="replace") as f:
                            self._info_cache[key] = node_infos_from_text(f.read())
                    infos = self._info_cache[key]
                else:
                    key = ("links", value)
                    if key not in self._info_cache:
                        self._info_cache[key] = node_infos_from_text(value)
                    infos = self._info_cache[key]
            except Exception as e:
                self.log("scan nodes: %s" % e)
            for name, info in infos:
                out.setdefault(name, info)
        return out

    def _collect(self):
        kind = self._kind()
        running = self._started and self._running_kind == kind
        snap = {"kind": kind, "label": CORES[kind]["label"],
                "installed": os.path.exists(_core_path(kind)),
                "tag": str(self.get_setting("core_tag_" + kind, "") or ""),
                "running": running, "port": self._port, "now": "", "active": "",
                "n_sources": len(self._load_sources())}
        groups = self._load_groups()
        gset = {"G:" + g["name"] for g in groups}
        cur = str(self.get_setting("cur_group", "") or "")
        if cur and cur not in {g["name"] for g in groups}:
            cur = ""
        snap["groups"], snap["cur_group"] = groups, cur
        snap["cols"] = 2 if str(self.get_setting("cols", "1")) == "2" else 1
        infos = self._scan_node_infos()
        names = []
        if running and self._api is not None:
            try:
                d = self._api.req("GET", "/proxies/PROXY") or {}
                snap["now"] = d.get("now", "")
                names = [n for n in (d.get("all") or [])
                         if n not in ("AUTO", "DIRECT", "direct") and n not in gset]
                # 当前选的是“自动 / 分组”时，顺着往下找出真正在用的节点
                node, hops = snap["now"], 0
                while node and (node == "AUTO" or node in gset) and hops < 3:
                    node = (self._api.req("GET", "/proxies/" + _q(node)) or {}).get("now", "")
                    hops += 1
                snap["active"] = node
            except Exception as e:
                self.log("collect: %s" % e)
        if not names:
            names = list(infos)
        snap["nodes"] = [{"name": n, "info": infos.get(n)} for n in names]
        return snap

    # --- 渲染 ---
    def _delay_text(self, name):
        d = self._delay.get(name)
        if d is None:
            return "未检测", "sub"
        if d == -2:
            return "检测中…", "sub"
        if d <= 0:
            return "超时", "bad"
        return "%d ms" % d, ("ok" if d < 300 else "warn")

    def _apply_delay(self, name):
        tv = self._delay_views.get(name)
        if tv is None:
            return
        text, color = self._delay_text(name)
        tv.setText(text)
        tv.setTextColor(self._c(color))

    def _render(self, snap):
        if self._dlg is None or self._content is None:
            return
        self._snap = snap
        try:
            y = int(self._scroll.getScrollY())
        except Exception:
            y = 0
        ct = self._content
        ct.removeAllViews()
        self._delay_views = {}
        busy, running = self._busy, snap["running"]

        # 状态卡片
        card = self._card()
        row = self._hbox()
        row.addView(self._icon())
        col = self._vbox()
        col.setPadding(self._dp(16), 0, 0, 0)
        col.setLayoutParams(self._lp(0, -2, weight=1))
        col.addView(self._text("已连接" if running else "断开连接", 22,
                               "text" if running else "off", True))
        if busy:
            sub = busy
        elif not snap["installed"]:
            sub = "连接文件不随插件提供，需要下载一次"
        elif running:
            sub = "%s · 127.0.0.1:%d" % (snap["label"], snap["port"])
        else:
            sub = "%s 已就绪%s" % (snap["label"], (" · " + snap["tag"]) if snap["tag"] else "")
        col.addView(self._text(sub, 13, "sub"))
        if running and not busy and snap["active"]:
            now = snap["now"]
            via = "（自动选择）" if now == "AUTO" else ("（分组自动选择）" if now.startswith("G:") else "")
            col.addView(self._text("使用中：" + snap["active"] + via, 13, "accent", lines=2))
        row.addView(col)
        card.addView(row)
        if busy:
            card.addView(self._button(busy, "gray", lambda: None))
        elif not snap["installed"]:
            card.addView(self._button("安装组件", "primary", self._dash_primary))
        elif running:
            card.addView(self._button("断开连接", "gray", self._dash_primary))
        else:
            card.addView(self._button("连接", "primary", self._dash_primary))
        ct.addView(card)

        # 工具按钮
        def tools(items):
            r = self._hbox()
            r.setLayoutParams(self._lp(-1, -2, m=(12, 2, 12, 2)))
            for text, fn in items:
                r.addView(self._button(text, "outline", fn, h=44, weight=1, m=(4, 4, 4, 4), sp=14))
            ct.addView(r)
        tools([("内核：" + snap["label"], lambda: self._choose_core()),
               ("订阅管理", lambda: self._manage())])
        tools([("更新订阅", lambda: self._busy_run("正在更新订阅…", self._refresh)),
               ("更新核心", lambda: self._busy_run(
                   "正在更新核心…", lambda: self._install_or_update(self._kind())))])

        cols = snap["cols"]
        tools([("分组管理", lambda: self._group_manage()),
               ("布局：" + ("双列" if cols == 2 else "单列"), lambda: self._toggle_cols())])

        # 分组芯片（点击即“使用该分组”）
        groups, cur = snap["groups"], snap["cur_group"]
        all_names = {n["name"] for n in snap["nodes"]}
        hs = jclass("android.widget.HorizontalScrollView")(self._act)
        hs.setHorizontalScrollBarEnabled(False)
        crow = self._hbox()
        crow.setPadding(self._dp(10), self._dp(6), self._dp(10), self._dp(6))

        def chip(text, sel, fn):
            tv = jclass("android.widget.TextView")(self._act)
            tv.setText(text)
            tv.setTextSize(14.0)
            tv.setGravity(17)
            tv.setTypeface(jclass("android.graphics.Typeface").DEFAULT_BOLD)
            tv.setPadding(self._dp(16), 0, self._dp(16), 0)
            if sel:
                tv.setBackground(self._shape("blue", 18))
                tv.setTextColor(jclass("android.graphics.Color").WHITE)
            else:
                tv.setBackground(self._shape("card", 18, "outline", sw=1))
                tv.setTextColor(self._c("accent"))
            tv.setClickable(True)
            tv.setOnClickListener(_VClick(fn))
            tv.setLayoutParams(self._lp(-2, self._dp(36), m=(4, 0, 4, 0)))
            crow.addView(tv)
        chip("全部", cur == "", lambda: self._run_bg(lambda: self._use_group("")))
        for g in groups:
            valid = len([x for x in g["nodes"] if x in all_names])
            chip("%s（%d）" % (g["name"], valid), cur == g["name"],
                 (lambda nm: (lambda: self._run_bg(lambda: self._use_group(nm))))(g["name"]))
        chip("＋ 新建分组", False, lambda: self._group_new())
        hs.addView(crow)
        ct.addView(hs)

        # 当前分组过滤
        members = None
        if cur:
            g = next((x for x in groups if x["name"] == cur), None)
            members = set(g["nodes"]) if g else None
        nodes = snap["nodes"] if members is None else [n for n in snap["nodes"] if n["name"] in members]

        if not snap["nodes"]:
            c = self._card()
            c.addView(self._text(
                "还没有订阅，请点上方“订阅管理”添加" if snap["n_sources"] == 0
                else "暂无节点，请点“更新订阅”拉取", 15, "sub"))
            ct.addView(c)
        else:
            head = self._hbox()
            head.setPadding(self._dp(24), self._dp(12), self._dp(24), self._dp(4))
            title = ("分组「%s」· 节点（%d）" % (cur, len(nodes))) if members is not None \
                else "节点（%d）" % len(nodes)
            t = self._text(title, 14, "sub", True)
            t.setLayoutParams(self._lp(0, -2, weight=1))
            head.addView(t)
            head.addView(self._small_button("全部测速", lambda: self._run_bg(self._test_all)))
            ct.addView(head)

            now = snap["now"]
            auto_target = ("G:" + cur) if members is not None else "AUTO"
            if members is not None and not nodes:
                c = self._card()
                c.addView(self._text("分组「%s」里没有可用节点，请在“分组管理”里重新勾选" % cur, 15, "sub"))
                ct.addView(c)
            else:
                auto_sel = running and now == auto_target
                c = self._card(selected=auto_sel, on_click=lambda: self._run_bg(
                    lambda: self._select_node(auto_target)))
                ico = self._hbox()
                ico.addView(self._icon())
                col = self._vbox()
                col.setPadding(self._dp(16), 0, 0, 0)
                col.addView(self._text(
                    ("✔ " if auto_sel else "") +
                    ("自动选择最快（分组：%s）" % cur if members is not None else "自动选择最快节点"),
                    18, "text", True))
                col.addView(self._text(
                    "URLTEST · 只在该分组内测速选择" if members is not None
                    else "URLTEST · 每 5 分钟自动检测", 14, "accent"))
                col.addView(self._text(
                    ("使用中：" + snap["active"]) if (auto_sel and snap["active"])
                    else ("当前使用" if auto_sel else "点击使用"), 14, "sub", lines=2))
                ico.addView(col)
                c.addView(ico)
                ct.addView(c)

            shown = nodes[:300]
            if cols == 2:
                for i in range(0, len(shown), 2):
                    rowc = self._hbox(48)
                    rowc.setLayoutParams(self._lp(-1, -2, m=(6, 0, 6, 0)))
                    for j in range(2):
                        if i + j < len(shown):
                            rowc.addView(self._node_card(shown[i + j], snap, True))
                        else:  # 单数时补一个占位，保证宽度一致
                            sp = jclass("android.view.View")(self._act)
                            sp.setLayoutParams(self._lp(0, 1, weight=1, m=(6, 6, 6, 6)))
                            rowc.addView(sp)
                    ct.addView(rowc)
            else:
                for n in shown:
                    ct.addView(self._node_card(n, snap, False))
            if len(nodes) > 300:
                c = self._card()
                c.addView(self._text("仅显示前 300 个节点（共 %d 个）" % len(nodes), 13, "sub"))
                ct.addView(c)
        try:
            self._scroll.post(_Run(lambda: self._scroll.scrollTo(0, y)))
        except Exception:
            pass

    def _node_card(self, n, snap, compact):
        name, info = n["name"], n["info"]
        sel = snap["running"] and snap.get("active") == name
        c = self._card(selected=sel, compact=compact, pad=16,
                       on_click=lambda: self._run_bg(lambda: self._select_node(name)))
        title = name
        line2 = ("%s · %s · %s" % (info["proto"], info["net"], info["sec"])) if info else "—"
        text, color = self._delay_text(name)
        dtv = self._text(text, 13, color)
        self._delay_views[name] = dtv
        test = lambda: self._run_bg(lambda: self._test_delay(name))
        if compact:
            trow = self._hbox()
            tt = self._text(title, 15, "text", True, lines=2)
            tt.setLayoutParams(self._lp(0, -2, weight=1))
            trow.addView(tt)
            if sel:
                trow.addView(self._badge("使用中"))
            c.addView(trow)
            c.addView(self._text(line2, 12, "accent", lines=1))
            bot = self._hbox()
            bot.setLayoutParams(self._lp(-1, -2, m=(0, 8, 0, 0)))
            dtv.setLayoutParams(self._lp(0, -2, weight=1))
            bot.addView(dtv)
            bot.addView(self._small_button("检测延迟", test))
            c.addView(bot)
        else:
            r = self._hbox()
            r.addView(self._icon(44, 16))
            col = self._vbox()
            col.setPadding(self._dp(12), 0, 0, 0)
            col.setLayoutParams(self._lp(0, -2, weight=1))
            trow = self._hbox()
            tt = self._text(title, 16, "text", True, lines=2)
            tt.setLayoutParams(self._lp(0, -2, weight=1))
            trow.addView(tt)
            if sel:
                trow.addView(self._badge("使用中"))
            col.addView(trow)
            col.addView(self._text(line2, 13, "accent", lines=1))
            col.addView(dtv)
            r.addView(col)
            r.addView(self._small_button("检测延迟", test))  # 按钮放在卡片末尾
            c.addView(r)
        return c

    # --- 布局切换 ---
    def _toggle_cols(self):
        cur = str(self.get_setting("cols", "1"))
        self.set_setting("cols", "1" if cur == "2" else "2")
        self._ui_refresh()

    # --- 节点分组 ---
    def _load_groups(self):
        try:
            raw = json.loads(self.get_setting("groups", "[]") or "[]")
        except Exception:
            raw = []
        out, seen = [], set()
        for g in raw if isinstance(raw, list) else []:
            if not isinstance(g, dict):
                continue
            name = str(g.get("name", "")).strip()
            if not name or name in seen:
                continue
            seen.add(name)
            out.append({"name": name, "nodes": [str(x) for x in (g.get("nodes") or [])]})
        return out

    def _save_groups(self, groups):
        self.set_setting("groups", json.dumps(groups, ensure_ascii=False))

    def _groups_for_config(self, known):
        """写进内核配置的分组：已知节点里至少要有一个成员，避免空分组退化成直连。"""
        out = []
        for g in self._load_groups():
            nodes = [n for n in g["nodes"] if n in known] if known else list(g["nodes"])
            if nodes:
                out.append({"name": g["name"], "nodes": nodes})
        return out

    def _all_node_names(self):
        names = [n["name"] for n in (self._snap or {}).get("nodes", [])]
        return names or list(self._scan_node_infos())

    def _restore_pick(self):
        """内核重启后，恢复上次选的节点 / 分组。"""
        api = self._api
        pick = str(self.get_setting("last_pick", "") or "")
        if api is None or not pick:
            return
        try:
            allv = (api.req("GET", "/proxies/PROXY") or {}).get("all") or []
            if pick not in allv:
                return
            if pick.startswith("G:"):
                members = next((g["nodes"] for g in self._load_groups() if g["name"] == pick[2:]), [])
                if not any(m in allv for m in members):
                    return
            api.req("PUT", "/proxies/PROXY", {"name": pick})
        except Exception as e:
            self.log("restore pick: %s" % e)

    def _use_group(self, name):
        """使用当前分组：名称为空表示“全部”（回到全局自动选择）。"""
        self.set_setting("cur_group", name)
        target = ("G:" + name) if name else "AUTO"
        self.set_setting("last_pick", target)
        if self._started and self._api is not None:
            try:
                self._api.req("PUT", "/proxies/PROXY", {"name": target})
            except Exception as e:
                _err("切换分组失败: %s" % e)
        self._ui_refresh()

    def _apply_groups(self, groups, tip):
        self._save_groups(groups)
        valid = {g["name"] for g in groups}
        cur = str(self.get_setting("cur_group", "") or "")
        if cur and cur not in valid:
            self.set_setting("cur_group", "")
            self.set_setting("last_pick", "AUTO")
        _info(tip)
        if self._started:  # 分组写在内核配置里，需要重启内核才生效
            self._busy_run("正在应用分组…", self._start)
        else:
            self._ui_refresh()

    def _group_manage(self):
        groups = self._load_groups()
        labels = ["＋ 新建分组"] + ["%s · %d 个节点" % (g["name"], len(g["nodes"])) for g in groups]
        list_dialog("分组管理（%d）" % len(groups), labels,
                    lambda i: self._group_new() if i == 0 else self._group_menu(i - 1))

    def _group_menu(self, idx):
        groups = self._load_groups()
        if idx >= len(groups):
            return
        g = groups[idx]

        def pick(i):
            if i == 0:
                self._group_pick_members(g["name"], g["nodes"], idx)
            elif i == 1:
                self._group_rename(idx)
            else:
                self._group_delete(idx)
        list_dialog("分组「%s」" % g["name"], ["编辑节点（勾选）", "重命名", "删除"], pick)

    def _group_new(self):
        def ok(vals):
            name = vals[0].strip()
            if not name:
                _toast("分组名称不能为空")
                return False
            if any(g["name"] == name for g in self._load_groups()):
                _toast("已有同名分组")
                return False
            self._group_pick_members(name, [], None)
        input_dialog("新建分组", ["分组名称"], [""], ok)

    def _group_pick_members(self, name, current, idx):
        names = self._all_node_names()
        if not names:
            _err("还没有节点，请先添加订阅并更新")
            return
        checked = [n in current for n in names]

        def ok(state):
            sel = [n for n, c in zip(names, state) if c]
            kept = [m for m in current if m not in names]  # 订阅里暂时消失的节点保留
            groups = self._load_groups()
            item = {"name": name, "nodes": sel + kept}
            if idx is None:
                groups.append(item)
            elif idx < len(groups):
                groups[idx] = item
            self._apply_groups(groups, "分组「%s」已保存（%d 个节点）" % (name, len(item["nodes"])))
        multi_dialog("勾选「%s」的节点（%d）" % (name, len(names)), names, checked, ok)

    def _group_rename(self, idx):
        groups = self._load_groups()
        if idx >= len(groups):
            return
        old = groups[idx]["name"]

        def ok(vals):
            new = vals[0].strip()
            cur = self._load_groups()
            if not new:
                _toast("分组名称不能为空")
                return False
            if any(g["name"] == new for i, g in enumerate(cur) if i != idx):
                _toast("已有同名分组")
                return False
            cur[idx]["name"] = new
            if str(self.get_setting("cur_group", "") or "") == old:
                self.set_setting("cur_group", new)
            if str(self.get_setting("last_pick", "") or "") == "G:" + old:
                self.set_setting("last_pick", "G:" + new)
            self._apply_groups(cur, "已重命名为「%s」" % new)
        input_dialog("重命名分组", ["分组名称"], [old], ok)

    def _group_delete(self, idx):
        groups = self._load_groups()
        if idx >= len(groups):
            return
        removed = groups.pop(idx)
        self._apply_groups(groups, "已删除分组「%s」" % removed["name"])

    # --- 面板动作 ---
    def _run_bg(self, fn):
        def go():
            try:
                fn()
            except Exception as e:
                self.log("dashboard action: %s" % e)
                _err(str(e))
        threading.Thread(target=go, name="proxy-core", daemon=True).start()

    def _busy_run(self, msg, fn):
        if self._busy:
            return
        self._busy = msg
        self._ui_refresh()

        def go():
            try:
                fn()
            except NeedRestart as e:
                self._ask_restart(str(e))
            except Exception as e:
                self.log("ProxyCore: %s" % e)
                _err(str(e))
            finally:
                self._busy = ""
                self._ui_refresh()
        threading.Thread(target=go, name="proxy-core", daemon=True).start()

    def _dash_primary(self):
        if self._busy:
            return
        snap = self._snap or {}
        kind = self._kind()
        if not snap.get("installed"):
            self._busy_run("正在下载组件…", lambda: self._install_or_update(kind, force=True))
        elif snap.get("running"):
            self._busy_run("正在断开…", self._manual_stop)
        else:
            self._busy_run("正在连接…", self._manual_start)

    def _select_node(self, name):
        if not self._started or self._api is None:
            raise RuntimeError("请先连接")
        self._api.req("PUT", "/proxies/PROXY", {"name": name})
        self.set_setting("last_pick", name)
        _info("已切换: " + ("自动选择" if name == "AUTO" else (
            "分组「%s」" % name[2:] if name.startswith("G:") else name)))
        self._ui_refresh()

    def _test_delay(self, name):
        if not self._started or self._api is None:
            raise RuntimeError("请先连接")
        self._delay[name] = -2
        run_on_ui_thread(lambda: self._apply_delay(name))
        try:
            r = self._api.req("GET", "/proxies/%s/delay?url=%s&timeout=5000" % (_q(name), _q(HC_URL)),
                              timeout=10)
            d = int((r or {}).get("delay", 0))
        except Exception:
            d = 0
        self._delay[name] = d if d > 0 else 0
        run_on_ui_thread(lambda: self._apply_delay(name))

    def _test_all(self):
        if not self._started or self._api is None:
            raise RuntimeError("请先连接")
        names = [n["name"] for n in (self._snap or {}).get("nodes", [])]
        for n in names:
            self._delay[n] = -2

        def mark():
            for n in names:
                self._apply_delay(n)
        run_on_ui_thread(mark)
        res = self._delays(self._api, names)
        for n in names:
            d = res.get(n)
            self._delay[n] = d if isinstance(d, int) and d > 0 else 0
        run_on_ui_thread(mark)

    def _status(self):
        k = self._kind()
        path = _core_path(k)
        size = os.path.getsize(path) / 1048576.0 if os.path.exists(path) else 0
        err = ""
        if _LIB_FUNCS is not None:
            err = (_LIB_FUNCS[2]() or b"").decode("utf-8", "replace")
        run = ("运行中 %s :%d" % (CORES[self._running_kind]["label"], self._port)) if self._started else "已停止"
        _info("当前内核: %s（%s）| %s | 订阅 %d 个%s" % (
            CORES[k]["label"], ("%.1f MB" % size) if size else "未安装", run,
            len(self._load_sources()), (" | 错误: " + err) if err else ""))
